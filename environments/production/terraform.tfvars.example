# Copy to terraform.tfvars in this same directory and fill in real values.
# terraform.tfvars is gitignored -- never commit it.

project     = "PesaGuard"
environment = "production"
region      = "us-east-1"

# Networking (Phase 3) -- production uses one NAT gateway per AZ, so at
# least 2 AZs is required (3 recommended).
vpc_cidr           = "10.30.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# DNS (Phase 3): production owns and creates the apex zone.
domain_name     = "pesaguard.victorkipruto.com"
create_dns_zone = true

# IAM / OIDC / Secrets (Phase 4) -- production creates the account-wide
# GitHub OIDC provider; restrict its role to the protected branch only.
github_org          = "Victor-Kipruto-Rop"
github_repo         = "pesaguard-infrastructure"
allowed_github_refs = ["ref:refs/heads/main"]
secret_names        = ["kafka/credentials"]  # database + redis credentials are self-managed by their own modules (RDS-managed secret; redis module-generated auth token)

# Data infrastructure (Phase 5) -- Multi-AZ, deletion-protected, longer
# retention for production
rds_instance_class          = "db.r6g.large"
rds_multi_az                = true
rds_deletion_protection     = true
rds_skip_final_snapshot     = false
rds_backup_retention_period = 30

redis_node_type                  = "cache.r6g.large"
redis_num_cache_clusters         = 2
redis_automatic_failover_enabled = true

# Messaging (Phase 6) -- MSK. number_of_broker_nodes must be a multiple of
# the number of AZs/subnets. 3 brokers, one per AZ (needs 3 entries in availability_zones). Manifest RF=3 applies as written.
msk_broker_instance_type   = "kafka.m5.large"
msk_number_of_broker_nodes = 3
msk_broker_ebs_volume_size = 500

# Added by later phases as the corresponding modules land:
# (compute, observability variables)
