# Copy to terraform.tfvars in this same directory and fill in real values.
# terraform.tfvars is gitignored -- never commit it.

project     = "PesaGuard"
environment = "development"
region      = "us-east-1"

# Networking (Phase 3)
vpc_cidr           = "10.10.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# DNS: development does not own the apex zone; leave unset until Phase 7
# adds a dev.pesaguard.* subdomain record in production's zone.
# domain_name = ""

# IAM / OIDC / Secrets (Phase 4)
github_org          = "Victor-Kipruto-Rop"
github_repo         = "pesaguard-infrastructure"
allowed_github_refs = ["ref:refs/heads/main", "ref:refs/heads/develop"]
secret_names        = ["kafka/credentials"]  # database + redis credentials are self-managed by their own modules (RDS-managed secret; redis module-generated auth token)

# Data infrastructure (Phase 5) -- small/cheap defaults for dev
rds_instance_class          = "db.t4g.micro"
rds_multi_az                = false
rds_deletion_protection     = false
rds_skip_final_snapshot     = true
rds_backup_retention_period = 3

redis_node_type                  = "cache.t4g.micro"
redis_num_cache_clusters         = 1
redis_automatic_failover_enabled = false

# Added by later phases as the corresponding modules land:
# (Kafka, compute, observability variables)
