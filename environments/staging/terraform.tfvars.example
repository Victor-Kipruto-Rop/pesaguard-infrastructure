# Copy to terraform.tfvars in this same directory and fill in real values.
# terraform.tfvars is gitignored -- never commit it.

project     = "PesaGuard"
environment = "staging"
region      = "us-east-1"

# Networking (Phase 3)
vpc_cidr           = "10.20.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# DNS: staging does not own the apex zone; leave unset until Phase 7
# adds a staging.pesaguard.* subdomain record in production's zone.
# domain_name = ""

# IAM / OIDC / Secrets (Phase 4)
github_org          = "Victor-Kipruto-Rop"
github_repo         = "pesaguard-infrastructure"
allowed_github_refs = ["ref:refs/heads/main"]
secret_names        = ["kafka/credentials"]  # database + redis credentials are self-managed by their own modules (RDS-managed secret; redis module-generated auth token)

# Data infrastructure (Phase 5) -- closer to production sizing, still
# single-AZ to control cost
rds_instance_class          = "db.t4g.small"
rds_multi_az                = false
rds_deletion_protection     = false
rds_skip_final_snapshot     = true
rds_backup_retention_period = 7

redis_node_type                  = "cache.t4g.small"
redis_num_cache_clusters         = 1
redis_automatic_failover_enabled = false

# Messaging (Phase 6) -- MSK. number_of_broker_nodes must be a multiple of
# the number of AZs/subnets. 2 brokers (one per AZ). Run apply-topics.sh with REPLICATION_FACTOR_CAP=2.
msk_broker_instance_type   = "kafka.t3.small"
msk_number_of_broker_nodes = 2
msk_broker_ebs_volume_size = 100

# Added by later phases as the corresponding modules land:
# (compute, observability variables)
